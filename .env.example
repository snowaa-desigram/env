# Локальная копия генерируется Ansible: make configure (или ansible-playbook playbooks/configure.yml).
# Источник правды — ansible/inventory/group_vars/*.yml. Руками править только для быстрых экспериментов.

PROJECT_NAME=gram-designer
APP_NAME="Gram Designer"
DOMAIN=gram-designer.localhost
PUBLIC_API_URL=https://api.gram-designer.localhost:8443
METRIKA_ID=
HTTP_PORT=8088
HTTPS_PORT=8443

MYSQL_DATABASE=desigram
MYSQL_USER=desigram
MYSQL_PASSWORD=desigram
MYSQL_ROOT_PASSWORD=root

RABBITMQ_USER=desigram
RABBITMQ_PASSWORD=desigram

APP_SECRET=change_me
JWT_SECRET=change_me_jwt_secret_at_least_32_bytes
TELEGRAM_BOT_TOKEN=

# SMTP для кодов подтверждения (локально — mailpit из docker-compose.dev.yml)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gram-designer.localhost
SMTP_TLS=false

# масштабирование
CORE_REPLICAS=1
CORE_WORKER_REPLICAS=1
PING_REPLICAS=1
TELEGRAM_REPLICAS=1
AUTH_REPLICAS=1
CORE_RATE_LIMIT=50
CORE_RATE_BURST=100
AUTH_RATE_LIMIT=10
AUTH_RATE_BURST=20

# Go-сервисы (go-zero): dev|test|pre|pro; OTLP-endpoint для трейсов (пусто — выключено)
GO_MODE=dev
OTEL_ENDPOINT=http://jaeger:4318/v1/traces

# prod
ACME_EMAIL=admin@gram-designer.com
