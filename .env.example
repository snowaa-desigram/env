# Локальная копия генерируется Ansible: make configure (или ansible-playbook playbooks/configure.yml).
# Источник правды — ansible/inventory/group_vars/*.yml. Руками править только для быстрых экспериментов.

DOMAIN=desigram.localhost
PUBLIC_API_URL=https://api.desigram.localhost:8443
HTTP_PORT=8088
HTTPS_PORT=8443

MYSQL_DATABASE=desigram
MYSQL_USER=desigram
MYSQL_PASSWORD=desigram
MYSQL_ROOT_PASSWORD=root

RABBITMQ_USER=desigram
RABBITMQ_PASSWORD=desigram

APP_SECRET=change_me
TELEGRAM_BOT_TOKEN=

# масштабирование
CORE_REPLICAS=1
CORE_WORKER_REPLICAS=1
PING_REPLICAS=1
TELEGRAM_REPLICAS=1
CORE_RATE_LIMIT=50
CORE_RATE_BURST=100

# Go-сервисы (go-zero): dev|test|pre|pro; OTLP-endpoint для трейсов (пусто — выключено)
GO_MODE=dev
OTEL_ENDPOINT=http://jaeger:4318/v1/traces

# prod
ACME_EMAIL=admin@desigram.com
