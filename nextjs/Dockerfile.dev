FROM node:22-alpine
WORKDIR /app
# pnpm dev сверяет node_modules с lock'ом и при расхождении переустанавливает; без TTY он спрашивает
# подтверждение на удаление node_modules и падает (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY). CI=true = «не спрашивай».
ENV CI=true
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install
COPY . .
EXPOSE 3000
CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
