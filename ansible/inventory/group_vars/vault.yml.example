# Секреты прода. Создать: ansible-vault create inventory/group_vars/prod/vault.yml (пароль — в .vault-pass, gitignored,
# и в GitHub secret ANSIBLE_VAULT_PASSWORD для CI). Файл коммитится зашифрованным.
vault_mysql_password: ...
vault_mysql_root_password: ...
vault_app_secret: ...            # Symfony APP_SECRET, 32+ символа
vault_jwt_secret: ...            # HS256, не короче 32 байт, общий для auth и core
vault_rabbitmq_password: ...
vault_smtp_password: ...
vault_telegram_bot_token: ...
vault_github_token: ...          # fine-grained PAT, contents:read на desigram/backend/env/front — для git clone на сервере
