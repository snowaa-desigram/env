# Сгенерировано Ansible из ansible/inventory/group_vars — не править руками.
PROJECT_NAME={{ project_name }}
APP_NAME="{{ app_name }}"
DOMAIN={{ domain }}
PUBLIC_API_URL={{ public_api_url }}
METRIKA_ID={{ metrika_id }}
HTTP_PORT={{ http_port }}
HTTPS_PORT={{ https_port }}

MYSQL_DATABASE={{ mysql_database }}
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}
MYSQL_ROOT_PASSWORD={{ mysql_root_password }}

RABBITMQ_USER={{ rabbitmq_user }}
RABBITMQ_PASSWORD={{ rabbitmq_password }}

APP_SECRET={{ app_secret }}
JWT_SECRET={{ jwt_secret }}
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}

SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USER={{ smtp_user }}
SMTP_PASSWORD={{ smtp_password }}
SMTP_FROM={{ smtp_from }}
SMTP_TLS={{ smtp_tls | lower }}

CORE_REPLICAS={{ core_replicas }}
CORE_WORKER_REPLICAS={{ core_worker_replicas }}
{% for name, replicas in service_replicas.items() %}
{{ name | upper }}_REPLICAS={{ replicas }}
{% endfor %}
CORE_RATE_LIMIT={{ core_rate_limit }}
CORE_RATE_BURST={{ core_rate_burst }}
AUTH_RATE_LIMIT={{ auth_rate_limit }}
AUTH_RATE_BURST={{ auth_rate_burst }}

GO_MODE={{ go_mode }}
OTEL_ENDPOINT={{ otel_endpoint }}

ACME_EMAIL={{ acme_email }}
